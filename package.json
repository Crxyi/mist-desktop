{
  "name": "mist-desktop",
  "productName": "Mist",
  "version": "1.0.0",
  "description": "Minimalist desktop shell and PC optimizer for Windows",
  "main": "main/main.js",
  "author": "Kozy",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable --x64"
  },
  "dependencies": {
    "koffi": "2.16.3"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "app.mist.desktop",
    "productName": "Mist",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main/**",
      "renderer/**",
      "assets/**",
      "preload.js",
      "package.json",
      "!node_modules/koffi/src/**",
      "!node_modules/koffi/doc/**",
      "!node_modules/koffi/build/koffi/{darwin_*,linux_*,freebsd_*,openbsd_*,musl_*,win32_arm64,win32_ia32}/**"
    ],
    "asarUnpack": [
      "node_modules/koffi/**"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "Mist-${version}-portable.exe"
    },
    "npmRebuild": false,
    "compression": "maximum"
  }
}